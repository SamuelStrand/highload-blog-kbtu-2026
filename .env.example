# Run `uv run blogctl setup` to generate private local values.
# The dedicated cluster is independent of PostgreSQL on port 5432.
PG_PORT=55432
PG_USER=sis2
PG_PASSWORD=replace-with-generated-local-password
JWT_SECRET=replace-with-generated-local-secret
# Optional app override; omit for the normal demo/test/bench database selection.
# DATABASE_URL=postgresql+asyncpg://sis2:password@127.0.0.1:55432/sis2_blog
